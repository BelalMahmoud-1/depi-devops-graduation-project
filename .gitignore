# =============================================================================
# .gitignore — Amazona DEPI DevOps Graduation Project
# Author : Mohamed Abdelkader <muhammadabdelkader@github>
# =============================================================================

# ─── Secrets & Environment Files ─────────────────────────────────────────────
# .env.example IS committed (it is the safe template).
# .env and any variant with real secrets must NEVER be committed.
.env
.env.*
!.env.example

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ─── Backend Build Output ─────────────────────────────────────────────────────
backend/dist/

# ─── Frontend Build Output ────────────────────────────────────────────────────
frontend/build/

# ─── Uploaded Files (runtime data, not source code) ──────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Docker ───────────────────────────────────────────────────────────────────
# docker-compose.yml and Dockerfiles ARE tracked (they are source code).
# Override files with local tweaks are excluded.
docker-compose.override.yml
