# =============================================================================
# Amazona — .env.example
# Author : Mohamed Abdelkader <muhammadabdelkader@github>
# Project: DEPI DevOps Graduation Project — Deliverable #1 (Dockerize)
#
# PURPOSE
# ───────
# This file is a SAFE TEMPLATE committed to Git. It contains all required
# environment variable names with placeholder (non-secret) values. Copy it to
# `.env` and fill in real secrets BEFORE running `docker compose up`.
#
# IMPORTANT: `.env` is listed in .gitignore and must NEVER be committed.
#            Only `.env.example` belongs in version control.
#
# USAGE
#   cp .env.example .env
#   # Edit .env with your real values
#   docker compose up -d
# =============================================================================


# =============================================================================
# Backend — Node.js Runtime Variables
# These are read by config.js via `dotenv.config()` when the container starts.
# =============================================================================

# Secret key used by jsonwebtoken to sign and verify JWTs.
# Use a long, random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# PayPal REST API client ID for the payment integration.
# Obtain from https://developer.paypal.com/developer/applications
# Use "sb" (sandbox) for local testing.
PAYPAL_CLIENT_ID=sb

# =============================================================================
# AWS SDK Variables
# Required if you want S3 image uploads to work in the uploadRoute.
# Leave the placeholder values for pure local Docker testing (Multer local
# storage will still work; only S3 uploads will fail without real credentials).
# =============================================================================

# AWS IAM access key with S3 write permissions.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS IAM secret access key corresponding to the access key above.
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS region where your S3 bucket is hosted.
AWS_REGION=us-east-1

# Name of the S3 bucket used to store product images.
AWS_BUCKET_NAME=amazona-product-images-example

# =============================================================================
# Frontend — React Build-Time Variable
# Read by docker-compose build.args and baked into the React JS bundle.
# Change this to your backend server IP/hostname if deploying to a remote server.
# =============================================================================

# The base URL the React app uses to make API calls.
# For local Docker: http://localhost:5000
# For a remote VM : http://<VM_PUBLIC_IP>:5000
# For production  : https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:5000
