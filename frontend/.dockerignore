# =============================================================================
# frontend/.dockerignore
# Author : Mohamed Abdelkader <muhammadabdelkader@github>
# Project: DEPI DevOps Graduation Project — Deliverable #1 (Dockerize)
#
# PURPOSE
# ───────
# Excludes files from the Docker build context when building the frontend image.
# Keeps builds fast, images small, and secrets out of the build pipeline.
# =============================================================================

# Node.js dependencies — installed fresh inside the container with `npm ci`.
node_modules/

# Previous build output — regenerated by `npm run build` during the Docker build.
# Excluding a stale local build prevents it from shadowing the fresh bundle.
build/

# Environment files — MUST never enter the Docker build context.
# React build args are passed via `--build-arg`, not baked into the image.
.env
.env.*
.env.local
.env.development
.env.production
.env.test

# Git metadata — large and irrelevant inside the container.
.git/
.gitignore

# Log files.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-generated files.
.DS_Store
Thumbs.db

# Editor / IDE configuration.
.vscode/
.idea/
